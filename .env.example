# LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=

# LangSmith (opcional) — só usado pelo `langgraph dev` (LangGraph Studio) para mandar
# traces de execução pro dashboard da LangChain. Sem essa chave o Studio continua
# funcionando normalmente (grafo, execução, estado); só não aparece o histórico de
# runs em smith.langchain.com. Gere uma chave grátis em smith.langchain.com (Settings
# > API Keys) e troque LANGSMITH_TRACING para "true" se quiser essa observabilidade —
# deixe "false" (ou a chave vazia) e não terá erro nenhum, só fica sem trace.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Banco de produção (read-only) — corretora SeguraPro
PRODUCTION_DB_HOST=localhost
PRODUCTION_DB_PORT=5432
PRODUCTION_DB_NAME=segurapro
PRODUCTION_DB_USER=segurapro_readonly
PRODUCTION_DB_PASSWORD=segurapro_dev

# Banco de metadados (pgvector)
METADATA_DB_HOST=localhost
METADATA_DB_PORT=5433
METADATA_DB_NAME=querymind_metadata
METADATA_DB_USER=querymind
METADATA_DB_PASSWORD=querymind_dev

# Criptografia de credenciais das conexões cadastradas (tabela `connections`).
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# App
LOG_LEVEL=INFO
SQL_TIMEOUT_SECONDS=30
SQL_MAX_ROWS=500
CORRECTION_MAX_RETRIES=3

# Frontend
# FRONTEND_URL é lido pelo backend (CORS). NEXT_PUBLIC_API_URL é embutido no bundle do
# navegador em build-time (ver frontend/Dockerfile) — não use o hostname interno do
# Docker (ex. http://backend:8000) aqui, o fetch roda no navegador do usuário, não na
# rede do compose.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
